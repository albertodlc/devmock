{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Test suit devmock",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-s"],
            "justMyCode": false
        },
        {
            "name": "Run devmock SSH",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "args": ["--ssh"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run devmock Telnet",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "args": ["--telnet"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}